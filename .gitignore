# Ignore virtual environment folder
venv/
localtest*
.venv/

.DS_Store

# Ignore Python bytecode files
__pycache__/
*.pyc

# Packaging/build artifacts
build/
dist/
*.egg-info/
# macOS
**/.DS_Store

# Local-only material: superseded notebooks and studies not part of the release
deprecated_notebooks/

# Figures are committed: the paper references them, and they are the quickest
# way to see what the notebooks produce without running them.

# On-disk caches built on first run
**/.dn_*_cache.npz

# setuptools-scm writes the version here at build time
mint/_version.py

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Oversized vector density map; pending rasterization (see follow-up)
MINT_examples/plots/beamline_density_map.pdf
